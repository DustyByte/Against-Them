[sub_resource type="GDScript" id="GDScript_70mjv"]
script/source = "class_name Retribution
extends Node2D

const MAX_SPEED: float = 25.0
const SPIN_DURATION: float = 0.6

@onready var mainEffect: Sprite2D = $Main
@onready var spinner: Sprite2D = $Spinner
@onready var light: PointLight2D = $PointLight2D
@onready var mainEffectMat: ShaderMaterial = mainEffect.material
@export var spinnerSpeedCurve: Curve = Curve.new()
@export var lightEnergyCurve: Curve = Curve.new()
var GPUParticleBP: PackedScene = preload(\"res://Scenes/Effects/particles_throw.tscn\")
var speed: float = 0.0
var displacement: float = 0.0
var damage: float = 0.0
var particleColor: Color = Color(0.741, 0.675, 0.867)


func setup(givenDamage: float, givenParticleColor: Color = particleColor) -> void:
	damage = givenDamage
	particleColor = givenParticleColor


func cleanup() -> void:
	get_parent().get_hit(damage)
	queue_free()


func throw_particles() -> void:
	var particles: GPUParticles2D = GPUParticleBP.instantiate()
	
	particles.global_position = global_position
	global.WORLD.add_child(particles)
	
	particles.amount = 8
	particles.z_index = 1
	particles.modulate = particleColor
	particles.finished.connect(particles.queue_free)
	
	particles.emitting = true


func bring_down_beamand_illuminate(val: float) -> void:
	mainEffectMat.set_shader_parameter('slider', val)
	light.energy = lightEnergyCurve.sample(1-(val/10.0)) * 2.0


func bam() -> void:
	var tween: Tween = get_tree().create_tween()
	
	tween.tween_method(bring_down_beamand_illuminate, 10.0, 0.0, 0.5)
	tween.finished.connect(cleanup)
	
	get_tree().create_timer(0.4).timeout.connect(throw_particles)


func handle_spinnerand_main_alpha(val: float) -> void:
	speed = MAX_SPEED*spinnerSpeedCurve.sample(val)
	spinner.material.set_shader_parameter('radius', val*0.45)
	mainEffectMat.set_shader_parameter('alpha', val)


func _ready() -> void:
	get_tree().create_timer(0.15).timeout.connect(bam) # 0.15 = SPIN_DURATION/4
	
	var tween: Tween = get_tree().create_tween()
	tween.tween_method(handle_spinnerand_main_alpha, 0.0, 1.0, SPIN_DURATION)


func _process(delta: float) -> void:
	if speed:
		displacement += speed * delta
		spinner.material.set_shader_parameter('displacement', displacement)
		print(spinner.material.get_shader_parameter(\"radius\"))
"

